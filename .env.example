# Example local environment file. Copy to `.env` and replace every value.
#
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed: it holds real credentials.
# This example file contains PLACEHOLDERS ONLY — no value here is, or has ever been, a
# real credential, and none of them is accepted as a fallback by the application.
#
# See docs/operations/configuration-and-secrets.md for what each variable means in
# production, and which categories must be rotated by the operator.

# --- Database (required; no application default for username/password) -------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/hotel
DATABASE_USERNAME=replace-with-local-database-user
DATABASE_PASSWORD=replace-with-local-database-password

# --- JWT signing secret (required; no application default) -------------------------------
# Use a long, random, environment-specific value. Never share it between environments.
JWT_SECRET=replace-with-a-long-random-locally-generated-signing-secret

# --- Initial administrator bootstrap (required; no application default) -------------------
# The password must satisfy the application password policy (8-72 characters); a weaker
# value aborts startup rather than being accepted.
BOOTSTRAP_ADMIN_USERNAME=replace-with-bootstrap-admin-username
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-compliant-bootstrap-admin-password

# --- Private file storage (optional locally, REQUIRED in production) ---------------------
# Left unset, the application uses the relative development defaults
# `var/guest-documents` and `var/room-images`. Production must set both to persistent,
# explicitly configured paths outside ephemeral deployment storage.
#GUEST_DOCUMENTS_PATH=/opt/hotel/data/guest-documents
#ROOM_IMAGES_PATH=/opt/hotel/data/room-images

# --- Locale cookie (optional) ------------------------------------------------------------
# Set to true when the application is served over HTTPS.
#HOTEL_I18N_COOKIE_SECURE=false
